{
    "name": "edulazaro/larasearch",
    "description": "Text search for Eloquent models on your own database: a normalized search_text column per model for fast list searches, and an optional global index for command palettes, scoped by tenant and filtered by what each user may see. No Elasticsearch, no Meilisearch.",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "eloquent", "search", "full-text", "fulltext", "command palette", "multi-tenant"],
    "authors": [
        {
            "name": "Edu Lazaro",
            "email": "edu@kenodo.com",
            "homepage": "https://edulazaro.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/console": ">=12.0",
        "illuminate/database": ">=12.0",
        "illuminate/support": ">=12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\Larasearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduLazaro\\Larasearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\Larasearch\\LarasearchServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
